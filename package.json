{
  "name": "dbt-self-help-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "prestart": "node tools/runtime/patch-vinext-windows-static-cache.mjs",
    "start": "vinext start",
    "test": "node tools/test/run-tests.mjs",
    "test:model": "node tools/eval/live-model-smoke.mjs",
    "eval:phase1": "npm run build && node tools/eval/run-nssi-phase1-evaluation.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .runtime --ignore-pattern .wrangler",
    "rag:build": ".venv\\Scripts\\python.exe tools\\rag\\build_index.py",
    "knowledge:build": ".venv\\Scripts\\python.exe tools\\knowledge\\build_knowledge_v2.py",
    "knowledge:validate": ".venv\\Scripts\\python.exe tools\\knowledge\\validate_knowledge_v2.py",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
