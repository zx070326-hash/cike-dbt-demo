# Without a key the demo runs in retrieval + verified-template mode.
# With a key it generates only from retrieved evidence and validates citations.
DEMO_MODEL_MODE=retrieval
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_MS=25000
MODEL_VERIFY_GROUNDING=true

# DeepSeek V4 Flash example (thinking is disabled automatically for JSON mode):
# DEMO_MODEL_MODE=generated
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-v4-flash

