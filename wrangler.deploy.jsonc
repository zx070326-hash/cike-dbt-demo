{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cike-dbt-demo",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cike-nssi-phase1",
      "database_id": "97ace12e-f44d-4024-be90-80b215aa4ed9"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "DEMO_MODEL_MODE": "generated",
    "MODEL_PROVIDER": "openai-compatible",
    "MODEL_BASE_URL": "https://api.deepseek.com",
    "MODEL_NAME": "deepseek-v4-flash",
    "MODEL_TIMEOUT_MS": "25000",
    "MODEL_VERIFY_GROUNDING": "true",
    "NSSI_SEMANTIC_RISK_MODE": "enabled",
    "RISK_MODEL_TIMEOUT_MS": "1800"
  }
}
